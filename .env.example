# Common paths. Keep the populated .env untracked.
DATASET_ROOT=/absolute/path/to/MSMU
MODEL_ROOT=/absolute/path/to/models
OUTPUT_ROOT=/absolute/path/to/msmu-outputs

# Select one inference family/profile per run.
PROFILE=llava_next_mistral_7b
RUN_NAME=
INDICES=
LIMIT=
RUN_SCORE=0
INFERENCE_RETRIES=2

# OpenAI-compatible inference (vLLM, OpenRouter, OpenAI, or Google).
BACKEND=vllm
INFERENCE_BASE_URL=http://127.0.0.1:18081/v1
SERVED_MODEL_NAME=llava-next-mistral-7b-msmu
INFERENCE_WORKERS=1
# Export one of these only in the untracked shell environment; never commit a value.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# VLLM_API_KEY=

# Existing Qwen/PEFT adapter.
BASE_MODEL=/absolute/path/to/Qwen2.5-VL-7B-Instruct
BASE_MODEL_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
CHECKPOINT=
CHECKPOINT_REVISION=
BATCH_SIZE=8
MAX_NEW_TOKENS=192
IMAGE_MIN_PIXELS=12544
IMAGE_MAX_PIXELS=112896

# Specialized upstream checkouts and locked local checkpoints.
SSR_UPSTREAM_ROOT=/absolute/path/to/SSR
SSR_VLM=/absolute/path/to/SSR-VLM-7B/snapshots/7bcb4636f1396325f27f7fbb2f2df121128931bf
SSR_MIDI=/absolute/path/to/SSR-MIDI-7B/snapshots/8ed878fa16e3e440741ed8c1fedfcfe40710258d
CLIP_MODEL=/absolute/path/to/clip-vit-large-patch14
CLIP_MODEL_REVISION=32bd64288804d66eefd0ccbe215aa642df71cc41
SIGLIP_MODEL=/absolute/path/to/siglip-so400m-patch14-384
SIGLIP_MODEL_REVISION=9fdffc58afc957d1a03a25b10dba0329ab15c2a3
MAMBA_MODEL=/absolute/path/to/mamba-130m-hf
MAMBA_MODEL_REVISION=1e76775f628fbf1350fbe4dbb3d971ba64af25a1
MIDI_LLM_MODEL=/absolute/path/to/Qwen2.5-7B
MIDI_LLM_MODEL_REVISION=d149729398750b98c0af14eb82c78cfe92750796
DEPTHPRO_CHECKPOINT=/absolute/path/to/depth_pro.pt
DEPTHPRO_CHECKPOINT_SHA256=3eb35ca68168ad3d14cb150f8947a4edf85589941661fdb2686259c80685c0ce

SPATIALRGPT_UPSTREAM_ROOT=/absolute/path/to/SpatialRGPT
THREEDTHINKER_UPSTREAM_ROOT=/absolute/path/to/3DThinker
SPATIALBOT_UPSTREAM_ROOT=/absolute/path/to/SpatialBot
ZOEDEPTH_ROOT=/absolute/path/to/ZoeDepth
ZOEDEPTH_CHECKPOINT=/absolute/path/to/ZoeD_M12_NK.pt

# Local judge is intentionally separate from INFERENCE_BASE_URL.
JUDGE_MODEL=/absolute/path/to/Qwen2.5-14B-Instruct
JUDGE_MODEL_NAME=msmu-judge
JUDGE_BASE_URL=http://127.0.0.1:18080/v1
PORT=18080
WORKERS=16
RETRIES=4
