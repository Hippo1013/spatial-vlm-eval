# CV-Bench server paths. Copy to an untracked .env.cvbench.server, or merge into .env.server.
SERVER_STORAGE_ROOT="${SERVER_STORAGE_ROOT:-/media/datasets/lihaoran}"
LEGACY_STORAGE_ROOT="${LEGACY_STORAGE_ROOT:-/media/datasets/tangzecong}"

CVBENCH_OUTPUT_ROOT="${CVBENCH_OUTPUT_ROOT:-${SERVER_STORAGE_ROOT}/latent_reasoning/cv-bench-outputs}"
# Verified legacy read-only directory containing the two locked Parquet files.
CVBENCH_DATASET_ROOT="${CVBENCH_DATASET_ROOT:-${LEGACY_STORAGE_ROOT}/huggingface/datasets/CV-Bench}"

HF_HOME="${HF_HOME:-${SERVER_STORAGE_ROOT}/huggingface}"
HF_HUB_CACHE="${HF_HUB_CACHE:-${HF_HOME}/hub}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-${HF_HOME}/datasets}"
CONDA_ENVS_PATH="${SERVER_STORAGE_ROOT}/conda/envs${CONDA_ENVS_PATH:+:${CONDA_ENVS_PATH}}"
CONDA_PKGS_DIRS="${CONDA_PKGS_DIRS:-${SERVER_STORAGE_ROOT}/conda/pkgs}"
CVBENCH_UPSTREAM_ROOT="${CVBENCH_UPSTREAM_ROOT:-${SERVER_STORAGE_ROOT}/upstreams/cv-bench}"
CVBENCH_CHECKPOINT_ROOT="${CVBENCH_CHECKPOINT_ROOT:-${SERVER_STORAGE_ROOT}/checkpoints/cv-bench}"

# Public APIs.
OPENROUTER_BASE_URL="${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1}"
CVBENCH_API_TIMEOUT="${CVBENCH_API_TIMEOUT:-180}"
CVBENCH_OPENROUTER_METADATA_RETRIES="${CVBENCH_OPENROUTER_METADATA_RETRIES:-10}"
CVBENCH_INFERENCE_RETRIES="${CVBENCH_INFERENCE_RETRIES:-2}"

# vLLM profiles require two endpoints for TP=1 fixed sharding and one endpoint for TP=2/4.
# Example: CVBENCH_QWEN3_VL_8B_BASE_URLS="http://127.0.0.1:18101/v1,http://127.0.0.1:18102/v1"
# InternVL3-78B additionally requires four explicit 80GB device ids.
# CVBENCH_INTERNVL3_78B_GPU_IDS="0,1,2,3"
CVBENCH_CAPACITY_CANDIDATES="${CVBENCH_CAPACITY_CANDIDATES:-32,16,8,4,2,1}"
CVBENCH_VLLM="${CVBENCH_VLLM:-vllm}"
CVBENCH_VLLM_MAX_MODEL_LEN="${CVBENCH_VLLM_MAX_MODEL_LEN:-8192}"
CVBENCH_VLLM_GPU_MEMORY_UTILIZATION="${CVBENCH_VLLM_GPU_MEMORY_UTILIZATION:-0.90}"

# Specialized profiles use one persistent JSON-lines runner command plus its implementation SHA-256.
# The command receives only index, final prompt, one PNG data URI, and locked runtime profile metadata.
# The repository runner is invoked with the model family's locked Python interpreter. Compute its
# digest with the same interpreter and --print-adapter-digest before setting the two variables.
# Example command (PYTHONPATH is inherited from scripts/cv_bench/_env.sh):
# CVBENCH_SPATIALRGPT_RGB_COMMAND="/path/to/python -u -m spatial_vlm_eval.benchmarks.cv_bench.specialized_runner --profile spatialrgpt_rgb"
# CVBENCH_SPATIALRGPT_RGB_ADAPTER_DIGEST="<64 lowercase hex characters>"
# SSR, direct 3DThinker, and SpatialLadder also point *_GENERATION_MANIFEST at the committed files in
# configs/cv-bench-generation/. RoboBrain, HiSpatial, SpatialLadder and MoGe model/upstream paths are
# ROBOBRAIN25_8B_{NV,MT}_MODEL, HISPATIAL_3B_MODEL, SPATIALLADDER_3B_MODEL, MOGE2_MODEL,
# MOGE2_UPSTREAM_ROOT and the
# corresponding *_UPSTREAM_ROOT variables.
