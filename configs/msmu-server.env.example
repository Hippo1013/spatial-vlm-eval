# Copy to an untracked .env on the evaluation server and adapt only when needed.
# New project files, outputs, downloads, package caches, and environments belong
# to the lihaoran namespace. Existing verified assets under tangzecong remain in
# place and are referenced explicitly below; do not download new assets there.
SERVER_STORAGE_ROOT=/media/datasets/lihaoran
LEGACY_STORAGE_ROOT=/media/datasets/tangzecong

REPO_ROOT="${SERVER_STORAGE_ROOT}/latent_reasoning/spatial-vlm-eval"
OUTPUT_ROOT="${SERVER_STORAGE_ROOT}/latent_reasoning/msmu-outputs"
# prepare_manual_test.sh uses this isolated root for all three manual stages.
MANUAL_TEST_OUTPUT_ROOT="${OUTPUT_ROOT}/manual-three-stage-v1"

# All future downloads and tool caches use the new namespace. MODEL_ROOT and
# DATA_DOWNLOAD_ROOT are the explicit destinations for local model/data trees;
# the standard cache variables cover Hugging Face, Conda, pip, uv, and PyTorch.
HF_HOME="${SERVER_STORAGE_ROOT}/huggingface"
HF_HUB_CACHE="${HF_HOME}/hub"
HF_DATASETS_CACHE="${HF_HOME}/datasets-cache"
HF_ASSETS_CACHE="${HF_HOME}/assets"
DATA_DOWNLOAD_ROOT="${HF_HOME}/datasets"
MODEL_ROOT="${HF_HOME}/models"
CONDA_ENVS_PATH="${SERVER_STORAGE_ROOT}/conda/envs:${LEGACY_STORAGE_ROOT}/miniconda3/envs:${LEGACY_STORAGE_ROOT}/latent_reasoning/envs"
CONDA_PKGS_DIRS="${SERVER_STORAGE_ROOT}/conda/pkgs"
XDG_CACHE_HOME="${SERVER_STORAGE_ROOT}/cache"
PIP_CACHE_DIR="${XDG_CACHE_HOME}/pip"
UV_CACHE_DIR="${XDG_CACHE_HOME}/uv"
TORCH_HOME="${XDG_CACHE_HOME}/torch"
UPSTREAM_ROOT="${SERVER_STORAGE_ROOT}/upstreams"
CHECKPOINT_ROOT="${SERVER_STORAGE_ROOT}/checkpoints"

# The current MSMU split and locked model/upstream checkouts already exist in
# tangzecong. Keep using those exact paths until a deliberate asset replacement.
LEGACY_MODEL_ROOT="${LEGACY_STORAGE_ROOT}/huggingface/models"
LEGACY_UPSTREAM_ROOT="${LEGACY_STORAGE_ROOT}/latent_reasoning/upstreams"
DATASET_ROOT="${LEGACY_STORAGE_ROOT}/huggingface/latent_reasoning/MSMU"
# Stage 3 starts this text-only judge only after full inference is complete.
JUDGE_MODEL="${LEGACY_MODEL_ROOT}/Qwen2.5-14B-Instruct"
JUDGE_MODEL_NAME=msmu-judge

# Family-specific interpreters keep incompatible model stacks isolated. Pass the
# matching value as PYTHON=... when invoking a pipeline.
LATENT_PYTHON="${LEGACY_STORAGE_ROOT}/miniconda3/envs/latent/bin/python"
VLLM_PYTHON="${LEGACY_STORAGE_ROOT}/miniconda3/envs/vllm019/bin/python"
VLLM="${LEGACY_STORAGE_ROOT}/miniconda3/envs/vllm019/bin/vllm"
SSR_PYTHON="${LEGACY_STORAGE_ROOT}/latent_reasoning/envs/msmu-ssr/bin/python"
SPATIALRGPT_PYTHON="${LEGACY_STORAGE_ROOT}/latent_reasoning/envs/msmu-spatialrgpt/bin/python"
THREEDTHINKER_PYTHON="${LEGACY_STORAGE_ROOT}/latent_reasoning/envs/msmu-3dthinker/bin/python"
SPATIALBOT_PYTHON="${LEGACY_STORAGE_ROOT}/latent_reasoning/envs/msmu-spatialbot/bin/python"

# Existing upstream source checkouts live outside this repository. New clones go
# under UPSTREAM_ROOT; these locked current checkouts stay at their legacy paths.
SSR_UPSTREAM_ROOT="${LEGACY_UPSTREAM_ROOT}/SSR"
SSR_DEPTHPRO_ROOT="${LEGACY_UPSTREAM_ROOT}/SSR-DepthPro"
SPATIALRGPT_UPSTREAM_ROOT="${LEGACY_UPSTREAM_ROOT}/SpatialRGPT"
THREEDTHINKER_UPSTREAM_ROOT="${LEGACY_UPSTREAM_ROOT}/3DThinker"
SPATIALBOT_UPSTREAM_ROOT="${LEGACY_UPSTREAM_ROOT}/SpatialBot"
ZOEDEPTH_ROOT="${LEGACY_UPSTREAM_ROOT}/ZoeDepth"

# Locked SSR components. Populate only after each revision has been verified.
BASE_MODEL="${LEGACY_MODEL_ROOT}/Qwen2.5-VL-7B-Instruct"
BASE_MODEL_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
# Qwen base/PEFT manual-test aliases. Add each PEFT checkpoint separately.
QWEN_BASE_MODEL="${BASE_MODEL}"
QWEN_BASE_REVISION="${BASE_MODEL_REVISION}"
QWEN_32B_MODEL="${LEGACY_MODEL_ROOT}/Qwen2.5-VL-32B-Instruct"
QWEN_32B_REVISION=7cfb30d71a1f4f49a57592323337a4a4727301da
QWEN_72B_MODEL="${LEGACY_MODEL_ROOT}/Qwen2.5-VL-72B-Instruct"
QWEN_72B_REVISION=89c86200743eec961a297729e7990e8f2ddbc4c5
# QWEN_PEFT_CHECKPOINT=/absolute/path/to/qwen-peft-checkpoint
# QWEN_PEFT_REVISION=<locked-hf-revision>
# Current Qwen3-VL supplement. Point this root at the four existing local directories.
QWEN3_MODEL_ROOT="${LEGACY_MODEL_ROOT}"
QWEN3_2B_MODEL="${QWEN3_MODEL_ROOT}/Qwen3-VL-2B-Instruct"
QWEN3_2B_REVISION=89644892e4d85e24eaac8bacfd4f463576704203
QWEN3_4B_MODEL="${QWEN3_MODEL_ROOT}/Qwen3-VL-4B-Instruct"
QWEN3_4B_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
QWEN3_8B_MODEL="${QWEN3_MODEL_ROOT}/Qwen3-VL-8B-Instruct"
QWEN3_8B_REVISION=0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
QWEN3_32B_MODEL="${QWEN3_MODEL_ROOT}/Qwen3-VL-32B-Instruct"
QWEN3_32B_REVISION=0cfaf48183f594c314753d30a4c4974bc75f3ccb
SSR_VLM="${LEGACY_MODEL_ROOT}/yliu-cs--SSR-VLM-7B/snapshots/7bcb4636f1396325f27f7fbb2f2df121128931bf"
SSR_MIDI="${LEGACY_MODEL_ROOT}/yliu-cs--SSR-MIDI-7B/snapshots/8ed878fa16e3e440741ed8c1fedfcfe40710258d"
CLIP_MODEL="${LEGACY_MODEL_ROOT}/openai--clip-vit-large-patch14/snapshots/32bd64288804d66eefd0ccbe215aa642df71cc41"
CLIP_MODEL_REVISION=32bd64288804d66eefd0ccbe215aa642df71cc41
SIGLIP_MODEL="${LEGACY_MODEL_ROOT}/google--siglip-so400m-patch14-384/snapshots/9fdffc58afc957d1a03a25b10dba0329ab15c2a3"
SIGLIP_MODEL_REVISION=9fdffc58afc957d1a03a25b10dba0329ab15c2a3
MAMBA_MODEL="${LEGACY_MODEL_ROOT}/state-spaces--mamba-130m-hf/snapshots/1e76775f628fbf1350fbe4dbb3d971ba64af25a1"
MAMBA_MODEL_REVISION=1e76775f628fbf1350fbe4dbb3d971ba64af25a1
MIDI_LLM_MODEL="${LEGACY_MODEL_ROOT}/Qwen--Qwen2.5-7B/snapshots/d149729398750b98c0af14eb82c78cfe92750796"
MIDI_LLM_MODEL_REVISION=d149729398750b98c0af14eb82c78cfe92750796
DEPTHPRO_CHECKPOINT="${LEGACY_STORAGE_ROOT}/ml-depth-pro/checkpoints/depth_pro.pt"
DEPTHPRO_CHECKPOINT_SHA256=3eb35ca68168ad3d14cb150f8947a4edf85589941661fdb2686259c80685c0ce

# Specialized model snapshots. Set MODEL_PATH to one of these for its pipeline.
LLAVA_MISTRAL_7B_MODEL="${LEGACY_MODEL_ROOT}/llava-v1.6-mistral-7b-hf"
LLAVA_YI_34B_MODEL="${LEGACY_MODEL_ROOT}/llava-v1.6-34b-hf"
INTERNVL3_8B_MODEL="${LEGACY_MODEL_ROOT}/InternVL3-8B-hf"
INTERNVL3_38B_MODEL="${LEGACY_MODEL_ROOT}/InternVL3-38B-hf"
# Four idle 80GB GPUs are required; the serve script fixes TP=4 and checks inventory.
INTERNVL3_78B_MODEL="${LEGACY_MODEL_ROOT}/InternVL3-78B-hf"
SPATIALRGPT_MODEL="${LEGACY_MODEL_ROOT}/a8cheng--SpatialRGPT-VILA1.5-8B/snapshots/64df7902f82b5053f5a53455095805e6de3a1f87"
THREEDTHINKER_MODEL="${LEGACY_MODEL_ROOT}/jankin123--3DThinker-Mindcube/snapshots/69a70411605f86ec69bada0a625bb96ddee995d9"
# SpatialBot is gated. Populate only after the user accepts its terms.
# SPATIALBOT_MODEL="${MODEL_ROOT}/RussRobin--SpatialBot-3B/snapshots/41d3b52c642058dfb087885bec0b8e37e0e67f8d"
# ZOEDEPTH_CHECKPOINT="${MODEL_ROOT}/ZoeDepth/ZoeD_M12_NK.pt"

CUDA_VISIBLE_DEVICES=0
INFERENCE_BASE_URL=http://127.0.0.1:18081/v1
JUDGE_BASE_URL=http://127.0.0.1:18080/v1
RUN_SCORE=0

# API credentials are deliberately absent. Export them only from an untracked shell.
