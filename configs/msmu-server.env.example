# Copy to an untracked .env on the evaluation server and adapt only when needed.
REPO_ROOT=/media/datasets/tangzecong/latent_reasoning/spatial-vlm-eval
DATASET_ROOT=/media/datasets/tangzecong/huggingface/latent_reasoning/MSMU
MODEL_ROOT=/media/datasets/tangzecong/huggingface/models
OUTPUT_ROOT=/media/datasets/tangzecong/latent_reasoning/msmu-outputs
# prepare_manual_test.sh uses this isolated root for all three manual stages.
MANUAL_TEST_OUTPUT_ROOT="${OUTPUT_ROOT}/manual-three-stage-v1"

# Family-specific interpreters keep incompatible model stacks isolated. Pass the
# matching value as PYTHON=... when invoking a pipeline.
LATENT_PYTHON=/media/datasets/tangzecong/miniconda3/envs/latent/bin/python
VLLM_PYTHON=/media/datasets/tangzecong/miniconda3/envs/vllm019/bin/python
VLLM=/media/datasets/tangzecong/miniconda3/envs/vllm019/bin/vllm
SSR_PYTHON=/media/datasets/tangzecong/latent_reasoning/envs/msmu-ssr/bin/python
SPATIALRGPT_PYTHON=/media/datasets/tangzecong/latent_reasoning/envs/msmu-spatialrgpt/bin/python
THREEDTHINKER_PYTHON=/media/datasets/tangzecong/latent_reasoning/envs/msmu-3dthinker/bin/python
SPATIALBOT_PYTHON=/media/datasets/tangzecong/latent_reasoning/envs/msmu-spatialbot/bin/python

# Upstream source checkouts live outside this repository.
UPSTREAM_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams
SSR_UPSTREAM_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams/SSR
SSR_DEPTHPRO_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams/SSR-DepthPro
SPATIALRGPT_UPSTREAM_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams/SpatialRGPT
THREEDTHINKER_UPSTREAM_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams/3DThinker
SPATIALBOT_UPSTREAM_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams/SpatialBot
ZOEDEPTH_ROOT=/media/datasets/tangzecong/latent_reasoning/upstreams/ZoeDepth

# Locked SSR components. Populate only after each revision has been verified.
BASE_MODEL=/media/datasets/tangzecong/huggingface/models/Qwen2.5-VL-7B-Instruct
BASE_MODEL_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
# Qwen base/PEFT manual-test aliases. Add each PEFT checkpoint separately.
QWEN_BASE_MODEL="${BASE_MODEL}"
QWEN_BASE_REVISION="${BASE_MODEL_REVISION}"
# QWEN_PEFT_CHECKPOINT=/absolute/path/to/qwen-peft-checkpoint
# QWEN_PEFT_REVISION=<locked-hf-revision>
SSR_VLM=/media/datasets/tangzecong/huggingface/models/yliu-cs--SSR-VLM-7B/snapshots/7bcb4636f1396325f27f7fbb2f2df121128931bf
SSR_MIDI=/media/datasets/tangzecong/huggingface/models/yliu-cs--SSR-MIDI-7B/snapshots/8ed878fa16e3e440741ed8c1fedfcfe40710258d
CLIP_MODEL=/media/datasets/tangzecong/huggingface/models/openai--clip-vit-large-patch14/snapshots/32bd64288804d66eefd0ccbe215aa642df71cc41
CLIP_MODEL_REVISION=32bd64288804d66eefd0ccbe215aa642df71cc41
SIGLIP_MODEL=/media/datasets/tangzecong/huggingface/models/google--siglip-so400m-patch14-384/snapshots/9fdffc58afc957d1a03a25b10dba0329ab15c2a3
SIGLIP_MODEL_REVISION=9fdffc58afc957d1a03a25b10dba0329ab15c2a3
MAMBA_MODEL=/media/datasets/tangzecong/huggingface/models/state-spaces--mamba-130m-hf/snapshots/1e76775f628fbf1350fbe4dbb3d971ba64af25a1
MAMBA_MODEL_REVISION=1e76775f628fbf1350fbe4dbb3d971ba64af25a1
MIDI_LLM_MODEL=/media/datasets/tangzecong/huggingface/models/Qwen--Qwen2.5-7B/snapshots/d149729398750b98c0af14eb82c78cfe92750796
MIDI_LLM_MODEL_REVISION=d149729398750b98c0af14eb82c78cfe92750796
DEPTHPRO_CHECKPOINT=/media/datasets/tangzecong/ml-depth-pro/checkpoints/depth_pro.pt
DEPTHPRO_CHECKPOINT_SHA256=3eb35ca68168ad3d14cb150f8947a4edf85589941661fdb2686259c80685c0ce

# Specialized model snapshots. Set MODEL_PATH to one of these for its pipeline.
LLAVA_MISTRAL_7B_MODEL=/absolute/path/to/llava-v1.6-mistral-7b-hf/snapshot
LLAVA_YI_34B_MODEL=/absolute/path/to/llava-v1.6-34b-hf/snapshot
INTERNVL3_8B_MODEL=/absolute/path/to/InternVL3-8B-hf/snapshot
INTERNVL3_38B_MODEL=/absolute/path/to/InternVL3-38B-hf/snapshot
INTERNVL3_78B_MODEL=/absolute/path/to/InternVL3-78B-hf/snapshot
SPATIALRGPT_MODEL=/media/datasets/tangzecong/huggingface/models/a8cheng--SpatialRGPT-VILA1.5-8B/snapshots/64df7902f82b5053f5a53455095805e6de3a1f87
THREEDTHINKER_MODEL=/media/datasets/tangzecong/huggingface/models/jankin123--3DThinker-Mindcube/snapshots/69a70411605f86ec69bada0a625bb96ddee995d9
# SpatialBot is gated. Populate only after the user accepts its terms.
# SPATIALBOT_MODEL=/media/datasets/tangzecong/huggingface/models/RussRobin--SpatialBot-3B/snapshots/41d3b52c642058dfb087885bec0b8e37e0e67f8d

CUDA_VISIBLE_DEVICES=0
INFERENCE_BASE_URL=http://127.0.0.1:18081/v1
JUDGE_BASE_URL=http://127.0.0.1:18080/v1
RUN_SCORE=0

# API credentials are deliberately absent. Export them only from an untracked shell.
