# Merge into the untracked .env.server; never commit credentials or private endpoints.

SPBENCH_SI_PARQUET=/media/datasets/tangzecong/huggingface/datasets/SPBench/SPBench-SI.parquet
SPBENCH_SI_IMAGES_ARCHIVE=/media/datasets/tangzecong/huggingface/datasets/SPBench/SPBench-SI-images.zip
SPBENCH_SI_OUTPUT_ROOT=/media/datasets/lihaoran/latent_reasoning/spbench-si-outputs
SPBENCH_SI_PYTHON="${LATENT_PYTHON}"

# Local vLLM 0.19 runtime and endpoint policy.
SPBENCH_SI_VLLM=vllm
SPBENCH_SI_VLLM_RUNTIME_VERSION=
SPBENCH_SI_VLLM_MAX_MODEL_LEN=32768
SPBENCH_SI_VLLM_GPU_MEMORY_UTILIZATION=0.90
SPBENCH_SI_CAPACITY_CANDIDATES=32,16,8,4,2,1
SPBENCH_SI_API_CAPACITY_CANDIDATES=8,4,2,1
SPBENCH_SI_SPATIALLADDER_BATCH_CANDIDATES=16,8,4,2,1

# Manual single-track example. The scheduled controller sets equivalent values per job.
SPBENCH_SI_QWEN3_VL_8B_GPU_IDS=0
SPBENCH_SI_QWEN3_VL_8B_BASE_URLS=http://127.0.0.1:18101/v1

# Independent four-card InternVL3-78B supplement. The one-click controller sets BASE_URLS.
SPBENCH_SI_INTERNVL3_78B_GPU_IDS=0,1,2,3
SPBENCH_SI_INTERNVL3_78B_PORT=18102
SPBENCH_SI_EVAL_SERVICE_TIMEOUT_SECONDS=1800
SPBENCH_SI_EVAL_STOP_TIMEOUT_SECONDS=120
SPBENCH_SI_EVAL_GPU_RELEASE_TIMEOUT_SECONDS=600
SPBENCH_SI_EVAL_POLL_SECONDS=10

# Locked general-model snapshots. Reuse verified existing paths; do not redownload into legacy storage.
LLAVA_MISTRAL_7B_MODEL=
LLAVA_YI_34B_MODEL=
INTERNVL3_8B_MODEL=
INTERNVL3_38B_MODEL=
INTERNVL3_78B_MODEL=
QWEN3_VL_2B_MODEL=
QWEN3_VL_4B_MODEL=
QWEN3_VL_8B_MODEL=
QWEN3_VL_32B_MODEL=

# OpenRouter first-party non-ZDR API. Keep the key only in .env.server or process environment.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Specialized checkpoints/upstreams and source-RGB-derived priors.
SSR_VLM_MODEL=
SSR_MIDI_MODEL=
SSR_UPSTREAM_ROOT=
SSR_DEPTHPRO_ROOT=
DEPTHPRO_CHECKPOINT=
BASE_MODEL=
CLIP_MODEL=
SIGLIP_MODEL=
MAMBA_MODEL=
MIDI_LLM_MODEL=

SPATIALRGPT_MODEL=
SPATIALRGPT_UPSTREAM_ROOT=
THREEDTHINKER_MODEL=
THREEDTHINKER_UPSTREAM_ROOT=
SPATIALBOT_MODEL=
SPATIALBOT_UPSTREAM_ROOT=
SPATIALBOT_SIGLIP_MODEL=
SPATIALBOT_MIDAS_ROOT=
ZOEDEPTH_ROOT=
ZOEDEPTH_CHECKPOINT=
ROBOBRAIN25_8B_NV_MODEL=
ROBOBRAIN25_8B_MT_MODEL=
ROBOBRAIN25_UPSTREAM_ROOT=
HISPATIAL_3B_MODEL=
HISPATIAL_UPSTREAM_ROOT=
MOGE2_MODEL=
MOGE2_UPSTREAM_ROOT=
MOGE2_UTILS3D_ROOT=
SPATIALLADDER_3B_MODEL=
SPATIALLADDER_UPSTREAM_ROOT=

# Each specialized command normally uses its isolated interpreter. Compute ADAPTER_DIGEST with
# that same interpreter and exact source tree:
# `PYTHON -m spatial_vlm_eval.benchmarks.spbench_si.specialized_runner --profile PROFILE --print-adapter-digest`.
# Commands below are intentionally blank until the operator binds an isolated environment.
SPBENCH_SI_SSR_RGB_COMMAND=
SPBENCH_SI_SSR_RGB_ADAPTER_DIGEST=
SPBENCH_SI_SSR_RGB_GENERATION_MANIFEST=configs/spbench-si-generation/ssr_rgb.json
SPBENCH_SI_SSR_NATIVE_COMMAND=
SPBENCH_SI_SSR_NATIVE_ADAPTER_DIGEST=
SPBENCH_SI_SSR_NATIVE_GENERATION_MANIFEST=configs/spbench-si-generation/ssr_native.json
SPBENCH_SI_SPATIALRGPT_RGB_COMMAND=
SPBENCH_SI_SPATIALRGPT_RGB_ADAPTER_DIGEST=
SPBENCH_SI_3DTHINKER_RGB_COMMAND=
SPBENCH_SI_3DTHINKER_RGB_ADAPTER_DIGEST=
SPBENCH_SI_3DTHINKER_RGB_GENERATION_MANIFEST=configs/spbench-si-generation/3dthinker_rgb.json
SPBENCH_SI_SPATIALBOT_RGB_COMMAND=
SPBENCH_SI_SPATIALBOT_RGB_ADAPTER_DIGEST=
SPBENCH_SI_SPATIALBOT_ZOEDEPTH_COMMAND=
SPBENCH_SI_SPATIALBOT_ZOEDEPTH_ADAPTER_DIGEST=
SPBENCH_SI_ROBOBRAIN25_8B_NV_RGB_COMMAND=
SPBENCH_SI_ROBOBRAIN25_8B_NV_RGB_ADAPTER_DIGEST=
SPBENCH_SI_ROBOBRAIN25_8B_MT_RGB_COMMAND=
SPBENCH_SI_ROBOBRAIN25_8B_MT_RGB_ADAPTER_DIGEST=
SPBENCH_SI_HISPATIAL3B_MOGE2_XYZ_COMMAND=
SPBENCH_SI_HISPATIAL3B_MOGE2_XYZ_ADAPTER_DIGEST=
SPBENCH_SI_SPATIALLADDER3B_RGB_COMMAND=
SPBENCH_SI_SPATIALLADDER3B_RGB_ADAPTER_DIGEST=
SPBENCH_SI_SPATIALLADDER3B_RGB_GENERATION_MANIFEST=configs/spbench-si-generation/spatialladder3b_rgb.json
