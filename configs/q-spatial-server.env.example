# Q-Spatial server paths. Copy selected values into the untracked .env.server.
QSPATIAL_PARQUET_ROOT=/media/datasets/tangzecong/huggingface/dataset/Q-Spatial-Bench
QSPATIAL_SCANNET_RGB_ROOT=/media/datasets/lihaoran/huggingface/datasets/Q-Spatial-Bench/QSpatial_scannet/images
QSPATIAL_OUTPUT_ROOT=/media/datasets/lihaoran/latent_reasoning/q-spatial-outputs
# Public entrypoints reuse LATENT_PYTHON when QSPATIAL_PYTHON/PYTHON is unset.
# QSPATIAL_PYTHON=/absolute/path/to/python

# Local vLLM uses one endpoint for every profile. The scheduled controller sets
# per-profile URLs and GPU ids; this fallback is for manual single-track runs.
QSPATIAL_VLLM_BASE_URLS=http://127.0.0.1:18101/v1
QSPATIAL_VLLM_API_TIMEOUT=600
# Must cover the locked image-tokenized prompt plus max_new_tokens; Qwen3 smoke exceeds 4096.
# Scheduler keeps LLaVA-NeXT Yi/Mistral at their checkpoint-safe 4096 limit.
QSPATIAL_VLLM_MAX_MODEL_LEN=32768
# Controller binding: TP=1 lists one GPU; TP=2/4 lists exactly TP GPUs.
QSPATIAL_QWEN3_VL_8B_GPU_IDS=0
QSPATIAL_INTERNVL3_78B_GPU_IDS=0,1,2,3
# Independent four-card supplemental controller; formal artifacts still use
# the existing QSPATIAL_OUTPUT_ROOT and q-spatial-result.md.
QSPATIAL_INTERNVL3_78B_PORT=18101
QSPATIAL_EVAL_SERVICE_TIMEOUT_SECONDS=1800
QSPATIAL_EVAL_STOP_TIMEOUT_SECONDS=120
QSPATIAL_EVAL_GPU_RELEASE_TIMEOUT_SECONDS=600
QSPATIAL_EVAL_POLL_SECONDS=10
QSPATIAL_CAPACITY_CANDIDATES=32,16,8,4,2,1
QSPATIAL_API_CAPACITY_CANDIDATES=8,4,2,1
# Bound Qwen2.5-VL visual attention for large Q-Spatial++ images in 3DThinker.
THREEDTHINKER_IMAGE_MIN_PIXELS=12544
THREEDTHINKER_IMAGE_MAX_PIXELS=401408

# Scheduled-batch ownership/readiness and read-only health watcher.
QSPATIAL_SCHEDULE_SERVICE_TIMEOUT_SECONDS=1800
QSPATIAL_SCHEDULE_STOP_TIMEOUT_SECONDS=120
QSPATIAL_SCHEDULE_GPU_RELEASE_TIMEOUT_SECONDS=600
QSPATIAL_SCHEDULE_POLL_SECONDS=10
QSPATIAL_SCHEDULE_HEALTH_POLL_SECONDS=60
QSPATIAL_SCHEDULE_STALL_SECONDS=1800
QSPATIAL_SCHEDULE_GPU_IDLE_GRACE_SECONDS=600

# Model paths are resolved by the locked registry; examples:
QWEN3_VL_8B_MODEL=/media/datasets/lihaoran/huggingface/models/Qwen3-VL-8B-Instruct
INTERNVL3_78B_MODEL=/media/datasets/lihaoran/huggingface/models/InternVL3-78B-hf

# API credentials are injected out of band and must never be committed.
# OPENROUTER_API_KEY=

# Specialized runners are one persistent JSONL process per track. Keep their
# adapter digest and, where required, generation manifest explicit.
# QSPATIAL_SSR_RGB_COMMAND=/absolute/python -m spatial_vlm_eval.benchmarks.q_spatial.specialized_runner --profile ssr_rgb --generation-manifest /absolute/repo/configs/q-spatial-generation/ssr_rgb.json
# QSPATIAL_SSR_RGB_ADAPTER_DIGEST=<64 lowercase hex characters>
# QSPATIAL_SSR_RGB_GENERATION_MANIFEST=/absolute/repo/configs/q-spatial-generation/ssr_rgb.json
