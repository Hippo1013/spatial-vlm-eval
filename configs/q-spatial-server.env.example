# Q-Spatial server paths. Copy selected values into the untracked .env.server.
QSPATIAL_PARQUET_ROOT=/media/datasets/tangzecong/huggingface/dataset/Q-Spatial-Bench
QSPATIAL_SCANNET_RGB_ROOT=/media/datasets/lihaoran/huggingface/datasets/Q-Spatial-Bench/QSpatial_scannet/images
QSPATIAL_OUTPUT_ROOT=/media/datasets/lihaoran/latent_reasoning/q-spatial-outputs

# Local vLLM endpoints. TP=1 profiles require two endpoints; TP=2/4 require one.
QSPATIAL_VLLM_BASE_URLS=http://127.0.0.1:18101/v1,http://127.0.0.1:18102/v1
QSPATIAL_VLLM_API_TIMEOUT=600
# Controller binding: TP=1 vLLM tracks list both endpoint GPUs; TP=2/4 list TP GPUs.
QSPATIAL_QWEN3_VL_8B_GPU_IDS=0,1
QSPATIAL_INTERNVL3_78B_GPU_IDS=0,1,2,3

# Model paths are resolved by the locked registry; examples:
QWEN3_VL_8B_MODEL=/media/datasets/lihaoran/huggingface/models/Qwen3-VL-8B-Instruct
INTERNVL3_78B_MODEL=/media/datasets/lihaoran/huggingface/models/InternVL3-78B-hf

# API credentials are injected out of band and must never be committed.
# OPENROUTER_API_KEY=

# Specialized runners are one persistent JSONL process per track. Keep their
# adapter digest and, where required, generation manifest explicit.
# QSPATIAL_SSR_RGB_COMMAND=/absolute/python -m spatial_vlm_eval.benchmarks.q_spatial.specialized_runner --profile ssr_rgb --generation-manifest /absolute/repo/configs/q-spatial-generation/ssr_rgb.json
# QSPATIAL_SSR_RGB_ADAPTER_DIGEST=<64 lowercase hex characters>
# QSPATIAL_SSR_RGB_GENERATION_MANIFEST=/absolute/repo/configs/q-spatial-generation/ssr_rgb.json
